# Octane Unified API Server
PORT=3001
NODE_ENV=production

# Supplier 1: Vente Reseller Bot
VENTE_BASE_URL=https://ventetelegrambotrailway-production.up.railway.app
VENTE_API_KEY=your_vente_reseller_key_here
VENTE_USD_RATE=16800

# Supplier 2: Rezeki Shop API (Prastya Neki)
REZEKI_BASE_URL=https://api.prastyaaneki.biz.id
REZEKI_API_KEY=your_rezeki_api_key_here
REZEKI_MARGIN_PERCENT=15
REZEKI_MIN_PRICE_IDR=8500

# Payment Gateways (Optional)
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here
MIDTRANS_MERCHANT_ID=your_midtrans_merchant_id_here
